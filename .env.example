# Copy to .env.local and fill in. Anything not prefixed VITE_ is server-side
# only and is never bundled into the browser build.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Supabase (browser) -------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_APP_URL="http://localhost:3000"

# --- Razorpay -----------------------------------------------------------
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# --- Google OAuth -------------------------------------------------------
VITE_GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"

# ========================================================================
# Edge Function secrets — set with `supabase secrets set KEY=value`, NOT here.
#   RAZORPAY_KEY_ID
#   RAZORPAY_KEY_SECRET
#   GOOGLE_OAUTH_CLIENT_ID
#   GOOGLE_OAUTH_CLIENT_SECRET
#   GROQ_API_KEY        (used by the generate-quiz function — groq.com console)
#   APP_URL
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
#  into functions automatically.)
# ========================================================================
